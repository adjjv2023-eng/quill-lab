{
  "name": "liminal-garden",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "An experimental browser sandbox for growing strange little worlds.",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.test.ts\"",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
