{
  "name": "morri",
  "version": "0.1.0",
  "type": "module",
  "description": "A fast, local-first CLI that audits a repository's health and prints a scored report.",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "morri": "bin/morri.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "keywords": [
    "audit",
    "repository",
    "health",
    "cli",
    "quality",
    "github"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm run lint && npm test",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.test.ts\"",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
